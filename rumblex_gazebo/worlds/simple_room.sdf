<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="hexapod_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Required system plugins for Gazebo Harmonic -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Sunlight -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground plane -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!--
      Simple room: 3m x 3m, walls 0.15m thick, 0.30m tall.
      Origin at room centre (0, 0).  Robot spawns near (-1, 0).
    -->

    <!-- North wall (y = +1.5) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 1.575 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.3 0.15 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.3 0.15 0.30</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall (y = -1.5) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -1.575 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.3 0.15 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.3 0.15 0.30</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall (x = +1.5) -->
    <model name="wall_east">
      <static>true</static>
      <pose>1.575 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 3.0 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 3.0 0.30</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall (x = -1.5) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-1.575 0 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.15 3.0 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 3.0 0.30</size></box></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Central obstacle (box 0.30 x 0.30) -->
    <model name="obstacle_centre">
      <static>true</static>
      <pose>0.5 0.3 0.15 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.30 0.30 0.30</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.30 0.30 0.30</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
