@@ -23,6 +23,10 @@
 ############## YDLIDAR SDK START#####################################
 #find ydlidar_sdk package
 find_package(ydlidar_sdk REQUIRED)
+# The SDK config omits its library directory for non-system prefixes.
+find_library(YDLIDAR_SDK_LIBRARY NAMES ydlidar_sdk REQUIRED)
+list(REMOVE_ITEM YDLIDAR_SDK_LIBRARIES ydlidar_sdk)
+list(PREPEND YDLIDAR_SDK_LIBRARIES "${YDLIDAR_SDK_LIBRARY}")
 ############## YDLIDAR SDK END#####################################
 
