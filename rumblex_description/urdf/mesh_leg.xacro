<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    Mesh leg variant.  The CAD exports are in millimetres and use the
    assembly joint as their local reference.  The small origins below are
    deliberately explicit: they document the CAD-to-URDF registration and
    keep the joint frames identical to leg.xacro.
  -->
  <xacro:macro name="mesh_hexapod_leg" params="prefix cx cy psi_deg">
    <xacro:property name="mount_yaw" value="${psi_deg * pi / 180.0 - pi / 2.0}"/>
    <xacro:property name="mesh_scale" value="0.001 0.001 0.001"/>

    <joint name="${prefix}_coxa_joint" type="revolute">
      <parent link="base_link"/>
      <child link="${prefix}_coxa_link"/>
      <origin xyz="${cx} ${cy} ${coxa_height}" rpy="0 0 ${mount_yaw}"/>
      <axis xyz="0 0 -1"/>
      <limit lower="${-60 * pi / 180}" upper="${60 * pi / 180}" effort="3.0" velocity="6.0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>
    <link name="${prefix}_coxa_link">
      <visual>
        <origin xyz="0 0.035 -0.01" rpy="${pi / 2.0} 0 0"/>
        <geometry><mesh filename="package://rumblex_description/meshes/assembly_coxa.stl" scale="${mesh_scale}"/></geometry>
        <material name="orange"/>
      </visual>
      <collision><origin xyz="0 ${coxa_length / 2.0} 0" rpy="${pi / 2.0} 0 0"/><geometry><box size="0.030 0.050 0.045"/></geometry></collision>
      <inertial><origin xyz="0 ${coxa_length / 2.0} 0"/><mass value="0.12"/><inertia ixx="3.0e-05" ixy="0" ixz="0" iyy="3.0e-05" iyz="0" izz="3.0e-05"/></inertial>
    </link>

    <joint name="${prefix}_femur_joint" type="revolute">
      <parent link="${prefix}_coxa_link"/><child link="${prefix}_femur_link"/>
      <origin xyz="0 ${coxa_length} 0" rpy="${30 * pi / 180} 0 0"/><axis xyz="1 0 0"/>
      <limit lower="${-30 * pi / 180}" upper="${90 * pi / 180}" effort="3.0" velocity="6.0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>
    <link name="${prefix}_femur_link">
      <visual>
        <origin xyz="0.015 0.043 0" rpy="${-90 * pi / 180} ${-90 * pi / 180} ${180 * pi / 180}"/>
        <geometry><mesh filename="package://rumblex_description/meshes/assembly_femur.stl" scale="${mesh_scale}"/></geometry>
        <material name="dark_blue"/>
      </visual>
      <collision><origin xyz="0 ${femur_length / 2.0} 0" rpy="${-pi / 2.0} 0 0"/><geometry><box size="0.030 0.063 0.045"/></geometry></collision>
      <inertial><origin xyz="0 ${femur_length / 2.0} 0"/><mass value="0.12"/><inertia ixx="4.0e-05" ixy="0" ixz="0" iyy="4.0e-05" iyz="0" izz="4.0e-05"/></inertial>
    </link>

    <joint name="${prefix}_tibia_joint" type="revolute">
      <parent link="${prefix}_femur_link"/><child link="${prefix}_tibia_link"/>
      <origin xyz="0 ${femur_length} 0" rpy="${-120 * pi / 180} 0 0"/><axis xyz="1 0 0"/>
      <limit lower="${-90 * pi / 180}" upper="${90 * pi / 180}" effort="3.0" velocity="6.0"/>
      <dynamics damping="0.1" friction="0.05"/>
    </joint>
    <link name="${prefix}_tibia_link">
      <visual>
        <!-- Rotate the CAD mesh by 90 degrees about the servo axis (link X),
             including its offset from that axis, to match assembly_complete.py. -->
        <origin xyz="-0.015 0 0.04" rpy="${-180 * pi / 180} 0 ${90 * pi / 180}"/>
        <geometry><mesh filename="package://rumblex_description/meshes/assembly_tibia.stl" scale="${mesh_scale}"/></geometry>
        <material name="light_blue"/>
      </visual>
      <collision><origin xyz="0 ${tibia_length / 2.0} 0" rpy="${-pi / 2.0} 0 0"/><geometry><box size="0.025 0.099 0.040"/></geometry></collision>
      <inertial><origin xyz="0 ${tibia_length / 2.0} 0"/><mass value="0.10"/><inertia ixx="4.0e-05" ixy="0" ixz="0" iyy="4.0e-05" iyz="0" izz="4.0e-05"/></inertial>
    </link>

    <joint name="${prefix}_foot_joint" type="fixed"><parent link="${prefix}_tibia_link"/><child link="${prefix}_foot"/><origin xyz="0 ${tibia_length} 0"/></joint>
    <link name="${prefix}_foot">
      <visual><geometry><sphere radius="0.006"/></geometry><material name="black"/></visual>
      <collision><geometry><sphere radius="0.006"/></geometry></collision>
      <inertial><mass value="0.005"/><inertia ixx="7.2e-08" ixy="0" ixz="0" iyy="7.2e-08" iyz="0" izz="7.2e-08"/></inertial>
    </link>
    <gazebo reference="${prefix}_foot"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  </xacro:macro>
</robot>
