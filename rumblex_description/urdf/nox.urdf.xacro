<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nox">

  <!-- Include sub-files -->
  <xacro:include filename="$(find rumblex_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find rumblex_description)/urdf/leg.xacro"/>
  <xacro:include filename="$(find rumblex_description)/urdf/ros2_control.xacro"/>

  <!-- ================================================================
       Robot dimensions from anatomy.yaml
       ================================================================ -->
  <xacro:property name="coxa_length"  value="0.050"/>
  <xacro:property name="femur_length" value="0.063"/>
  <xacro:property name="tibia_length" value="0.099"/>
  <xacro:property name="coxa_height"  value="0.045"/>

  <!-- Body visual approximation -->
  <xacro:property name="body_length"  value="0.240"/>
  <xacro:property name="body_width"   value="0.180"/>
  <xacro:property name="body_height"  value="0.025"/>
  <xacro:property name="body_mass"    value="0.400"/>

  <!-- ================================================================
       Gazebo plugin (for simulation with gz_ros2_control)
       ================================================================ -->
  <xacro:arg name="use_sim" default="false"/>

  <xacro:if value="$(arg use_sim)">
    <gazebo>
      <plugin filename="gz_ros2_control-system"
              name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <parameters>$(find rumblex_gazebo)/config/nox/joint_controllers.yaml</parameters>
      </plugin>
    </gazebo>
    <xacro:rumblex_ros2_control/>
  </xacro:if>

  <!-- ================================================================
       BASE LINK (body platform)
       ================================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.020" rpy="0 0 0"/>
      <geometry>
        <box size="${body_length} ${body_width} ${body_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.020"/>
      <mass value="${body_mass}"/>
      <inertia ixx="${body_mass * (body_width*body_width + body_height*body_height) / 12}"
               ixy="0" ixz="0"
               iyy="${body_mass * (body_length*body_length + body_height*body_height) / 12}"
               iyz="0"
               izz="${body_mass * (body_length*body_length + body_width*body_width) / 12}"/>
    </inertial>
  </link>

  <gazebo reference="base_link">
    <material>
      <ambient>0.3 0.3 0.3 1</ambient>
      <diffuse>0.3 0.3 0.3 1</diffuse>
    </material>
  </gazebo>

  <!-- BNO055 IMU mounted on bottom plate, X-axis aligned with robot X -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0 0 0.0075" rpy="0 0 0"/>
  </joint>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.020 0.027 0.004"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.020 0.027 0.004"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.003"/>
      <inertia ixx="1.0e-07" ixy="0" ixz="0"
               iyy="1.0e-07" iyz="0"
               izz="1.0e-07"/>
    </inertial>
  </link>

  <gazebo reference="imu_link">
    <material>
      <ambient>0.15 0.15 0.15 1</ambient>
      <diffuse>0.15 0.15 0.15 1</diffuse>
    </material>
  </gazebo>

  <!-- ================================================================
       LEGS (6 legs, dimensions from anatomy.yaml leg_offsets)
       ================================================================ -->

  <!-- Right side -->
  <xacro:hexapod_leg prefix="right_front"
                     cx="0.109"  cy="0.068"  psi_deg="45.0"/>
  <xacro:hexapod_leg prefix="right_mid"
                     cx="0.000"  cy="0.088"  psi_deg="90.0"/>
  <xacro:hexapod_leg prefix="right_back"
                     cx="-0.109" cy="0.068"  psi_deg="135.0"/>

  <!-- Left side -->
  <xacro:hexapod_leg prefix="left_front"
                     cx="0.109"  cy="-0.068" psi_deg="-45.0"/>
  <xacro:hexapod_leg prefix="left_mid"
                     cx="0.000"  cy="-0.088" psi_deg="-90.0"/>
  <xacro:hexapod_leg prefix="left_back"
                     cx="-0.109" cy="-0.068" psi_deg="-135.0"/>

  <!-- ================================================================
       HEAD (yaw + pitch)
       ================================================================ -->
  <joint name="head_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="head_yaw_link"/>
    <origin xyz="0.130 0 ${coxa_height}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-30 * pi / 180}" upper="${30 * pi / 180}"
           effort="1.5" velocity="4.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="head_yaw_link">
    <visual>
      <origin xyz="0 0 0.010"/>
      <geometry>
        <cylinder radius="0.015" length="0.020"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.010"/>
      <geometry>
        <cylinder radius="0.015" length="0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.010"/>
      <mass value="0.025"/>
      <inertia ixx="1.5e-06" ixy="0" ixz="0"
               iyy="1.5e-06" iyz="0"
               izz="2.8e-06"/>
    </inertial>
  </link>

  <joint name="head_pitch_joint" type="revolute">
    <parent link="head_yaw_link"/>
    <child link="head_pitch_link"/>
    <origin xyz="0 0 0.020" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-20 * pi / 180}" upper="${20 * pi / 180}"
           effort="1.5" velocity="4.0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="head_pitch_link">
    <visual>
      <origin xyz="0.015 0 0"/>
      <geometry>
        <box size="0.030 0.035 0.025"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.015 0 0"/>
      <geometry>
        <box size="0.030 0.035 0.025"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.015 0 0"/>
      <mass value="0.025"/>
      <inertia ixx="5.0e-06" ixy="0" ixz="0"
               iyy="3.5e-06" iyz="0"
               izz="5.0e-06"/>
    </inertial>
  </link>

  <!-- Garmin LIDAR Lite v2 mounted on head, pointing forward (+X) -->
  <joint name="lidar_joint" type="fixed">
    <parent link="head_pitch_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.030 0 0" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <origin xyz="0.020 0 0"/>
      <geometry>
        <box size="0.040 0.048 0.020"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.2 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.020 0 0"/>
      <geometry>
        <box size="0.040 0.048 0.020"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.020 0 0"/>
      <mass value="0.022"/>
      <inertia ixx="2.0e-06" ixy="0" ixz="0"
               iyy="1.5e-06" iyz="0"
               izz="2.5e-06"/>
    </inertial>
  </link>

  <gazebo reference="lidar_link">
    <material>
      <ambient>0.2 0.2 0.2 1</ambient>
      <diffuse>0.2 0.2 0.2 1</diffuse>
    </material>
    <!-- Simulated 1-beam rangefinder (Garmin LIDAR Lite v3 equivalent) -->
    <xacro:if value="$(arg use_sim)">
      <sensor name="lidar_sensor" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>lidar_scan</topic>
        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <ray>
          <scan>
            <horizontal>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.05</min>
            <max>40.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
    </xacro:if>
  </gazebo>

  <gazebo reference="head_yaw_link">
    <material>
      <ambient>0.8 0.1 0.1 1</ambient>
      <diffuse>0.8 0.1 0.1 1</diffuse>
    </material>
  </gazebo>
  <gazebo reference="head_pitch_link">
    <material>
      <ambient>0.8 0.1 0.1 1</ambient>
      <diffuse>0.8 0.1 0.1 1</diffuse>
    </material>
  </gazebo>

</robot>
