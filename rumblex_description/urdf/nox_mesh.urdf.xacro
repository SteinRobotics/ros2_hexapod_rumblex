<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="nox">
  <xacro:include filename="$(find rumblex_description)/urdf/materials.xacro"/>
  <xacro:include filename="$(find rumblex_description)/urdf/mesh_leg.xacro"/>
  <xacro:include filename="$(find rumblex_description)/urdf/ros2_control.xacro"/>
  <xacro:property name="mesh_directory" value="package://rumblex_description/meshes/nox"/>
  <xacro:property name="coxa_length" value="0.050"/>
  <xacro:property name="femur_length" value="0.063"/>
  <xacro:property name="tibia_length" value="0.099"/>
  <xacro:property name="coxa_height" value="0.045"/>
  <xacro:arg name="use_sim" default="false"/>

  <xacro:if value="$(arg use_sim)">
    <gazebo><plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin"><parameters>$(find rumblex_gazebo)/config/nox/joint_controllers.yaml</parameters></plugin></gazebo>
    <xacro:rumblex_ros2_control/>
  </xacro:if>

  <link name="base_link">
    <visual><origin xyz="0 0 0"/><geometry><mesh filename="${mesh_directory}/assembly_body_servo.stl" scale="0.001 0.001 0.001"/></geometry><material name="dark_gray"/></visual>
    <collision><origin xyz="0 0 0.020"/><geometry><box size="0.240 0.180 0.025"/></geometry></collision>
    <inertial><origin xyz="0 0 0.045"/><mass value="0.80"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.005"/></inertial>
  </link>

  <xacro:mesh_hexapod_leg prefix="right_front" cx="0.109" cy="0.068" psi_deg="45.0"/>
  <xacro:mesh_hexapod_leg prefix="right_mid" cx="0.000" cy="0.088" psi_deg="90.0"/>
  <xacro:mesh_hexapod_leg prefix="right_back" cx="-0.109" cy="0.068" psi_deg="135.0"/>
  <xacro:mesh_hexapod_leg prefix="left_front" cx="0.109" cy="-0.068" psi_deg="-45.0"/>
  <xacro:mesh_hexapod_leg prefix="left_mid" cx="0.000" cy="-0.088" psi_deg="-90.0"/>
  <xacro:mesh_hexapod_leg prefix="left_back" cx="-0.109" cy="-0.068" psi_deg="-135.0"/>

  <!-- Head transforms reproduce the zero-angle placement in
       cad/assembly_complete.py.  The body mesh already contains the yaw
       servo; these links add its coxa bracket and the pitch-mounted head. -->
  <joint name="head_yaw_joint" type="revolute">
    <parent link="base_link"/>
    <child link="head_yaw_link"/>
    <origin xyz="0.140175 0 0.04825"/>
    <axis xyz="0 0 -1"/>
    <limit lower="${-30*pi/180}" upper="${30*pi/180}" effort="1.5" velocity="4.0"/>
  </joint>
  <link name="head_yaw_link">
    <visual>
      <origin xyz="0.0295 0 -0.0143" rpy="${90*pi/180} 0 ${-90*pi/180}"/>
      <geometry><mesh filename="${mesh_directory}/assembly_coxa.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <inertial><mass value="0.001"/><inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/></inertial>
  </link>
  <joint name="head_pitch_joint" type="revolute">
    <parent link="head_yaw_link"/>
    <child link="head_pitch_link"/>
    <origin xyz="0.05313138535886 0.0143 -0.00338993770857"/>
    <axis xyz="0 -1 0"/>
    <limit lower="${-20*pi/180}" upper="${20*pi/180}" effort="1.5" velocity="4.0"/>
  </joint>
  <link name="head_pitch_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="${180*pi/180} 0 0"/>
      <geometry><mesh filename="${mesh_directory}/assembly_head.stl" scale="0.001 0.001 0.001"/></geometry>
      <material name="dark_gray"/>
    </visual>
    <inertial><mass value="0.001"/><inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/></inertial>
  </link>
</robot>
