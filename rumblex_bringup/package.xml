<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rumblex_bringup</name>
  <version>0.0.1</version>
  <description>Launch files and bringup configuration for the RumbleX hexapod platform</description>
  <maintainer email="stein.robotics@gmail.com">christian</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>bno055</exec_depend>
  <exec_depend>rumblex_brain</exec_depend>
  <exec_depend>rumblex_communication</exec_depend>
  <exec_depend>rumblex_hmi</exec_depend>
  <exec_depend>rumblex_lidar</exec_depend>
  <exec_depend>rumblex_movement</exec_depend>
  <exec_depend>rumblex_navigation</exec_depend>
  <exec_depend>rumblex_teleop</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
