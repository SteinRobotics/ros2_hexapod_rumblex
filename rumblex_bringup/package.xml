<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rumblex_bringup</name>
  <version>0.0.1</version>
  <description>Launch files and bringup configuration for the RumbleX hexapod platform</description>
  <maintainer email="stein.robotics@gmail.com">christian</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ros2launch</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>bno055</exec_depend>
  <exec_depend>rumblex_brain</exec_depend>
  <exec_depend>rumblex_gazebo</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>rumblex_communication</exec_depend>
  <exec_depend>rumblex_description</exec_depend>
  <exec_depend>rumblex_hmi</exec_depend>
  <exec_depend>rumblex_lidar_1d</exec_depend>
  <exec_depend>rumblex_lidar_2d</exec_depend>
  <exec_depend>rumblex_perception_lidar</exec_depend>
  <exec_depend>rumblex_perception_face</exec_depend>
  <exec_depend>rumblex_camera</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rumblex_movement</exec_depend>
  <exec_depend>rumblex_navigation</exec_depend>
  <exec_depend>rumblex_teleop</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>xacro</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
