<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rumblex_hmi</name>
  <version>0.0.0</version>
  <description>Human-machine interface (OLED display, relay control, power monitoring) for the RumbleX hexapod platform</description>
  <maintainer email="stein.robotics@gmail.com">christian</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>

  <depend>rumblex_interfaces</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
